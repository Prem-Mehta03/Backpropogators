    "S04": {"mode": "confidence_conflict", "sensors": ["camera"], "claim_perspectives": {"stored_status": "historical", "sensor_status": "agent_sensor"}},
    "S05": {"mode": "sensor_disagreement", "sensors": ["lidar", "camera"], "claim_perspectives": {"lidar_status": "agent_sensor:lidar", "camera_status": "agent_sensor:camera"}},
    "S08": {"mode": "user_safety", "sensors": ["lidar"], "claim_perspectives": {"user_status": "user", "path_status": "agent_sensor"}}
